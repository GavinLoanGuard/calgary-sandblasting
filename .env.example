# Copy to .env.local for local development. In production, set these as
# Environment Variables in the Vercel project settings instead.

# GA4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads conversion tracking (e.g. AW-XXXXXXXXX / abc123XYZ)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Web3Forms access key — get one free at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
